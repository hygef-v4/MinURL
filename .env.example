# Supabase Database & Auth (Required)
SUPABASE_URL=https://<your-supabase-project>.supabase.co
SUPABASE_KEY=<your-supabase-anon-key>

# Application Base URL (Required for generating short links)
BASE_DOMAIN=http://localhost:8000

# Google Safe Browsing API (Optional: For checking malicious URLs)
SAFE_BROWSING_API_KEY=<your-google-safe-browsing-api-key>
